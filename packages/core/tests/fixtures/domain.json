[
  {
    "name": "resource capability honors type and prefix",
    "action": {
      "type": "supportsResource",
      "manifest": {
        "resources": [{ "name": "stream", "types": ["movie"], "idPrefixes": ["tt"] }]
      },
      "resource": "stream",
      "mediaType": "movie",
      "id": "tt123"
    },
    "expected": true
  },
  {
    "name": "resource URL encodes extras",
    "action": {
      "type": "buildResourceUrl",
      "manifestUrl": "https://example.com/manifest.json",
      "resource": "catalog",
      "mediaType": "movie",
      "id": "popular",
      "extras": [{ "name": "search", "value": "The Matrix" }]
    },
    "expected": "https://example.com/catalog/movie/popular/search=The%20Matrix.json"
  },
  {
    "name": "long playback completes in the final two minutes",
    "action": {
      "type": "isPlaybackComplete",
      "positionMs": 500000,
      "durationMs": 600000
    },
    "expected": true
  },
  {
    "name": "invalid leap day is rejected",
    "action": {
      "type": "releaseDateKey",
      "value": "2023-02-29"
    },
    "expected": null
  },
  {
    "name": "watched final episode with no upcoming episode is completed",
    "action": {
      "type": "continueWatching",
      "progress": {
        "videoId": "finale",
        "mediaType": "series",
        "mediaId": "finished-show",
        "season": 1,
        "episode": 2,
        "positionMs": 100000,
        "durationMs": 100000,
        "watched": true
      },
      "videos": [
        {
          "id": "first",
          "season": 1,
          "episode": 1
        },
        {
          "id": "finale",
          "season": 1,
          "episode": 2
        }
      ],
      "today": "2026-10-02",
      "nowMs": 1790942400000
    },
    "expected": {
      "kind": "completed",
      "videoIndex": 1
    }
  },
  {
