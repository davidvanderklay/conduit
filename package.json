{
  "name": "conduit",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "vp run ci:build",
    "check": "pnpm check:deps && pnpm check:flatpak && vp run ci:check",
    "check:flatpak": "node scripts/check-flatpak-node-sources.mjs",
    "check:deps": "node scripts/check-package-manifests.mjs",
    "format": "vp fmt --write",
    "lint": "vp lint --deny-warnings",
    "lint:fix": "vp lint --fix --deny-warnings",
    "core:build": "wasm-pack build packages/core --target web --out-dir pkg",
    "admin:recover": "corepack pnpm --filter @conduit/server cli -- admin recover",
    "db:generate": "pnpm --filter @conduit/server db:generate",
    "db:migrate": "pnpm --filter @conduit/server db:migrate",
    "dev": "vp run app:dev",
    "dev:server": "pnpm --filter @conduit/server dev",
    "dev:desktop": "pnpm --filter @conduit/desktop dev",
    "dev:electron": "pnpm --filter @conduit/desktop electron:dev",
    "dev:web": "pnpm --filter @conduit/web dev",
    "test:releases": "node --test scripts/release-context.test.mjs scripts/publish-component-release.test.mjs scripts/verify-android-release.test.mjs scripts/publish-update-feed.test.mjs scripts/publish-nightly-tags.test.mjs",
    "test": "vp run ci:test",
    "test:updates": "pnpm --filter @conduit/updates build && vitest run packages/updates/src apps/server/src/updates.test.ts apps/server/src/route-modules/update-routes.test.ts apps/desktop/electron/updates.test.ts"
  },
  "devDependencies": {
    "@voidzero-dev/vite-plus-core": "0.3.3",
    "@voidzero-dev/vite-plus-test": "0.1.24",
    "semver": "7.8.5",
    "vite-plus": "0.3.3",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@10.14.0"
}
