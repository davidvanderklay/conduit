{
  "name": "@conduit/server",
  "private": true,
  "license": "MIT",
  "bin": {
    "conduit": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @conduit/updates build && tsc -p tsconfig.json",
    "check": "pnpm --filter @conduit/updates build && tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:built": "node dist/migrate.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run src"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/sensible": "6.0.7",
    "@sinclair/typebox": "0.34.52",
    "better-auth": "1.7.12",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "ws": "8.22.0",
    "@conduit/updates": "workspace:*"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "files": [
    "dist",
    "drizzle"
  ]
}
