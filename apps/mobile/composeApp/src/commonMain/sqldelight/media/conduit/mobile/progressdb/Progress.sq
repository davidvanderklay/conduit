CREATE TABLE progress_sync_scope (
  scope_key TEXT NOT NULL PRIMARY KEY,
  generation INTEGER NOT NULL,
  cursor INTEGER NOT NULL,
  initialized INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE progress_projection (
  scope_key TEXT NOT NULL,
  canonical_episode_key TEXT NOT NULL,
  canonical_title_id TEXT NOT NULL,
  revision INTEGER NOT NULL,
  payload TEXT NOT NULL,
  PRIMARY KEY (scope_key, canonical_episode_key)
);

CREATE INDEX progress_projection_title_idx
ON progress_projection(scope_key, canonical_title_id);

CREATE TABLE progress_outbox_operation (
  scope_key TEXT NOT NULL,
  operation_id TEXT NOT NULL,
  operation_type TEXT NOT NULL,
  canonical_title_key TEXT NOT NULL,
  canonical_episode_key TEXT,
  payload TEXT NOT NULL,
  attempt_count INTEGER NOT NULL DEFAULT 0,
  next_attempt_at INTEGER NOT NULL DEFAULT 0,
  last_error TEXT,
  failed INTEGER NOT NULL DEFAULT 0,
  created_at INTEGER NOT NULL,
  PRIMARY KEY (scope_key, operation_id)
);

CREATE INDEX progress_outbox_due_idx
ON progress_outbox_operation(scope_key, failed, next_attempt_at, created_at);

selectScope:
SELECT * FROM progress_sync_scope WHERE scope_key = ?;

upsertScope:
INSERT OR REPLACE INTO progress_sync_scope(scope_key, generation, cursor, initialized)
VALUES (?, ?, ?, ?);

clearProjection:
DELETE FROM progress_projection WHERE scope_key = ?;

selectProjection:
SELECT payload FROM progress_projection WHERE scope_key = ? ORDER BY canonical_episode_key;

selectProjectionByTitle:
SELECT * FROM progress_projection WHERE scope_key = ? AND canonical_title_id = ?;

upsertProjection:
INSERT OR REPLACE INTO progress_projection(scope_key, canonical_episode_key, canonical_title_id, revision, payload)
VALUES (?, ?, ?, ?, ?);

deleteEpisodeProjection:
DELETE FROM progress_projection
WHERE scope_key = ? AND canonical_title_id = ? AND canonical_episode_key = ?;

deleteTitleProjection:
DELETE FROM progress_projection WHERE scope_key = ? AND canonical_title_id = ?;

setTitleDismissed:
UPDATE progress_projection SET payload = ?, revision = ? WHERE scope_key = ? AND canonical_title_id = ?;

insertOperation:
INSERT INTO progress_outbox_operation(
  scope_key, operation_id, operation_type, canonical_title_key, canonical_episode_key,
  payload, attempt_count, next_attempt_at, last_error, failed, created_at
) VALUES (?, ?, ?, ?, ?, ?, 0, 0, NULL, 0, ?);

selectDueOperations:
SELECT * FROM progress_outbox_operation
WHERE scope_key = ? AND failed = 0 AND next_attempt_at <= ?
ORDER BY created_at
LIMIT ?;

selectOperations:
SELECT * FROM progress_outbox_operation WHERE scope_key = ? ORDER BY created_at;

deleteOperation:
DELETE FROM progress_outbox_operation WHERE scope_key = ? AND operation_id = ?;

deleteOlderEpisodeOperations:
DELETE FROM progress_outbox_operation
WHERE scope_key = ? AND canonical_episode_key = ? AND created_at <= ?;

deleteOlderTitleOperations:
DELETE FROM progress_outbox_operation
WHERE scope_key = ? AND canonical_title_key = ? AND created_at <= ?;

recordRetry:
UPDATE progress_outbox_operation
SET attempt_count = ?, next_attempt_at = ?, last_error = ?, failed = ?
WHERE scope_key = ? AND operation_id = ?;

retryOperation:
UPDATE progress_outbox_operation SET next_attempt_at = 0, last_error = NULL, failed = 0
WHERE scope_key = ? AND operation_id = ?;

discardOperation:
DELETE FROM progress_outbox_operation WHERE scope_key = ? AND operation_id = ?;

clearScope:
DELETE FROM progress_sync_scope WHERE scope_key = ?;
