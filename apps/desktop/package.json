{
  "name": "@conduit/desktop",
  "private": true,
  "license": "MIT",
  "main": "electron/dist/main.js",
  "scripts": {
    "build": "pnpm electron:native:build && pnpm --dir ../.. --filter @conduit/web build && pnpm electron:main:build",
    "check": "if ! pkg-config --exists mpv 2>/dev/null; then echo 'Skipping desktop check (pkg-config mpv not found)'; else cargo check -p conduit-electron-native; fi",
    "dev": "pnpm electron:native:build && pnpm electron:main:build && node electron/run.mjs .",
    "electron:build": "pnpm electron:native:build && pnpm --dir ../.. --filter @conduit/web build && pnpm electron:main:build",
    "electron:dev": "pnpm electron:native:build && pnpm electron:main:build && node electron/run.mjs .",
    "electron:main:build": "tsc -p electron/tsconfig.json",
    "electron:native:build": "node electron-native/build.mjs",
    "electron:run": "node electron/run.mjs .",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "test": "cargo test -p conduit-electron-native",
    "dist": "pnpm build && electron-builder",
    "dist:win": "pnpm build && electron-builder --win --x64",
    "dist:linux": "pnpm build && electron-builder --linux --x64",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win:arm64": "pnpm build && electron-builder --win --arm64",
    "dist:mac:arm64": "pnpm build && electron-builder --mac --arm64",
    "dist:mac:x64": "pnpm build && electron-builder --mac --x64"
  },
  "devDependencies": {
    "@types/node": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest"
  },
  "version": "0.1.0",
  "build": {
    "appId": "media.conduit.desktop",
    "productName": "conduit",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "icons"
    },
    "files": [
      "electron/dist/**/*",
      "electron-native/dist/**/*",
      "icons/**/*",
      "!**/*.ts",
      "!**/*.map",
      "!**/*.md"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64",
          "ia32"
        ]
      },
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}"
    },
    "linux": {
      "target": {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      "icon": "icons/icon.png",
      "category": "AudioVideo",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "icon": "icons/icon.icns",
      "category": "public.app-category.entertainment",
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}"
    },
    "dmg": {
      "sign": false
    }
  },
  "description": "Conduit desktop media client",
  "author": "Conduit"
}
