{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "conduit",
  "version": "0.1.0",
  "identifier": "media.conduit.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @conduit/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm core:build && pnpm --filter @conduit/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "conduit",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#00000000",
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
