# Public URL users open. Set this to your HTTPS URL behind a reverse proxy.
CONDUIT_URL=http://localhost:8080
# Change the host port if 8080 is already occupied.
CONDUIT_PORT=8080

# Generate each value once and keep it backed up:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
#   openssl rand -hex 32
ADDON_ENCRYPTION_KEY=replace-with-64-hex-characters
