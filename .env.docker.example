# Pin a release for repeatable upgrades. `latest` follows stable releases.
CONDUIT_VERSION=latest
# Public URL users open. Set this to your HTTPS URL behind a reverse proxy.
CONDUIT_URL=http://localhost:8321
# Keep the default loopback bind unless a deliberate LAN/router exposure is wanted.
CONDUIT_BIND_ADDRESS=127.0.0.1
# Change the host port if 8321 is already occupied.
CONDUIT_PORT=8321
# The bundled nginx proxy overwrites the client IP headers before forwarding.
TRUST_PROXY=true

# The first owner must provide this private token in the browser.
CONDUIT_BOOTSTRAP_MODE=setup-token
# Generate with: openssl rand -base64 32
CONDUIT_BOOTSTRAP_TOKEN=replace-with-a-private-bootstrap-token

# Keep this stable: it is the PostgreSQL password for the named volume.
POSTGRES_PASSWORD=replace-with-a-database-password

# Generate each value once and keep it backed up:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
#   openssl rand -hex 32
ADDON_ENCRYPTION_KEY=replace-with-64-hex-characters
