DATABASE_URL=postgresql://conduit:conduit@127.0.0.1:5432/conduit
# Change this when another PostgreSQL server already uses port 5432.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=conduit
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
ADDON_ENCRYPTION_KEY=replace-with-64-hex-characters
WEB_ORIGIN=http://localhost:5173
PORT=3000
# Set true only when a trusted reverse proxy overwrites forwarded client IP headers.
TRUST_PROXY=false
VITE_API_URL=http://localhost:3000
# Local development keeps the original first-user flow. Docker overrides this to setup-token.
CONDUIT_BOOTSTRAP_MODE=first-user
